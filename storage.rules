rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isAuthenticated() && getUserData().statusAktif == true;
    }

    function isAdmin() {
      return isActiveUser() && getUserData().role == 'Admin';
    }

    // Folder Foto Aset (Hanya gambar, maksimal 5MB)
    match /aset_foto/{fileName} {
      allow read: if isActiveUser();
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Folder Dokumen Aset (Gambar atau PDF, maksimal 5MB)
    match /aset_dokumen/{fileName} {
      allow read: if isActiveUser();
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType == 'application/pdf'
        );
      allow delete: if isAdmin();
    }
  }
}