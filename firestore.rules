rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserDoc().data.statusAktif == true;
    }

    function isAdmin() {
      return isActiveUser() && getUserDoc().data.role == 'Admin';
    }

    // --- COLLECTION: users ---
    match /users/{userId} {
      // User boleh membaca profilnya sendiri saat login untuk cek statusAktif & role
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // --- COLLECTION: master_aset ---
    match /master_aset/{asetId} {
      // Admin & Staff aktif boleh melihat daftar dan detail aset
      allow read: if isActiveUser();

      // Hanya Admin yang boleh menambah atau menghapus aset
      allow create, delete: if isAdmin();

      // Admin bebas edit semua kolom; Staff hanya boleh update kolom hasil Stock Opname
      allow update: if isAdmin() || (
        isActiveUser() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['kondisi', 'lokasi', 'catatan', 'terakhirAudit', 'updatedAt'])
      );
    }

    // --- COLLECTION: log_aktivitas ---
    match /log_aktivitas/{logId} {
      allow read: if isActiveUser();

      // Admin & Staff aktif boleh mencatat log, wajib sesuai UID pengirim
      allow create: if isActiveUser()
        && request.resource.data.petugasUid == request.auth.uid;

      // Riwayat audit tidak boleh diubah/dihapus sembarangan
      allow update, delete: if isAdmin();
    }

    // --- COLLECTION: referensi ---
    match /referensi/{refId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }
  }
}